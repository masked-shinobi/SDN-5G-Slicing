# 5G Network Slicing Dashboard Environment Configuration

# Open5GS MongoDB Connection (Ubuntu host)
MONGODB_URI=mongodb://localhost:27017/open5gs

# Open5GS Prometheus Metrics Endpoint
METRICS_URL=http://127.0.0.1:9090/metrics

# UERANSIM Path
UERANSIM_DIR=/home/ubuntu/UERANSIM

# Log Paths
OPEN5GS_LOG_DIR=/var/log/open5gs

# Execution Mode: "auto" detects Linux environment / falls back to demo simulation
DEMO_MODE=auto

# Application Host & Port
PORT=3000
HOST=127.0.0.1

